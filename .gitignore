# The directory Mix will write compiled artifacts to.
/_build/

# Alternate MIX_BUILD_PATH used for isolated test compiles.
/_build_t/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Hex package manager cache — written into worktrees by mix deps.get.
/.hex

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Local Claude Code agent config.
.claude/

# Per-spawn Wardmast.MCP client config — written into each acolyte worktree by
# Wardmast.MCP.AgentConfig with a bearer scope token baked in. Never commit it.
.mcp.json

# Agent-generated build artifacts — not part of the canonical repo.
BUILD-SUMMARY-*.md
MORNING-BRIEF.md


# Arbiter run artifacts
.arbiter/

# Compiled Erlang/Elixir beam artifacts — mix test can compile these into the
# worktree root (e.g. Elixir.Wardmast.Worker.Worktree.beam). They are never
# part of the canonical repo and must not trip the commit gate (bd-3gpeoz).
*.beam

# Local environment file with secrets (DATABASE_PATH, WARDMAST_CLOAK_KEY, SECRET_KEY_BASE).
# Never commit to version control.
.wardmast.env
.wardmast.env.backup

# Generated by `arb install-service` for dev-mode source checkouts (bd-1vhgn7).
.run-server.sh

# SQLite and database artifacts (legacy local development artifacts from pre-Postgres era).
*.sqlite3
*.db

# Dialyzer PLTs — built once for the whole umbrella (see mix.exs `dialyzer/0`).
# Multi-hundred-MB binaries derived entirely from mix.lock; CI caches them
# instead of committing them.
/priv/plts/

# Scratch test files at root — never commit (prevents test.exs scratch scripts).
/test.exs

# Candidate account plan emitted by `mix wardmast.accounts.census` (bd-1p8n2d).
# Workspace names, env var names and credential fingerprints — not to be
# committed by accident.
accounts.json

# Default output dir for scripts/build-local-release.sh — drops a multi-tens-
# of-MB release tarball + escript per run in whatever clone it's pointed at.
.local-release/

# Pre-rename spelling of the checkout env file (scripts/migrate-from-arbiter.sh renames it).
.arbiter.env
.arbiter.env.backup

# The CDP capture runner's npm install (bd-485ts3); the worker image runs its own `npm ci`.
/apps/wardmast/priv/capture/node_modules/
