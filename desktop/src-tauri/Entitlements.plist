<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Applied to the app and to every Mach-O file in the bundled release when
     package-macos.sh signs with the hardened runtime (notarisation requires
     it). The Erlang VM's JIT writes and then executes machine code, which the
     hardened runtime forbids unless these are granted; nothing else is. -->
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
